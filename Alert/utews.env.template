# ============================================================================
# U-TEWS Real-Time Environment Variables
# ============================================================================
# File ini berisi credential & konfigurasi sensitif.
# Letakkan di /home/orangepi/utews/utews.env
# Set permission: chmod 600 utews.env (hanya owner yang bisa baca)
# ============================================================================

# --- Telegram Bot ---
# 1. Buka @BotFather di Telegram
# 2. Kirim /newbot, ikuti instruksi → dapat TOKEN
# 3. Cari bot kamu, kirim pesan apapun
# 4. Buka https://api.telegram.org/bot<TOKEN>/getUpdates → cari "chat":{"id":XXX}
# 5. Isi di bawah ini:

UTEWS_TG_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ1234567890
UTEWS_TG_CHAT_ID=-1001234567890

# --- Opsional: override path data ---
# UTEWS_DATA_DIR=/home/orangepi/data/water
# UTEWS_LOG_DIR=/home/orangepi/data/utews_realtime
