# Kredensial dan pengaturan uploader.
# Salin ke /home/orangepi/Buoy-V3/uploader/uploader.env lalu:
#     chmod 600 /home/orangepi/Buoy-V3/uploader/uploader.env
# File ini dibaca oleh systemd service buoy-uploader.

UPLOADER_MQTT_BROKER=77.37.63.21
UPLOADER_MQTT_PORT=1883
UPLOADER_MQTT_USER=adminvps
UPLOADER_MQTT_PASSWORD=pwdMQTT@123

# Kosongkan untuk kirim ke topik asli (buoyV3/wind, dst).
# Isi "batch/" selama masa uji supaya tidak mengganggu data lama.
UPLOADER_TOPIC_PREFIX=batch/

# Folder data & catatan (biarkan default kalau tidak ada alasan mengubah)
#UPLOADER_DATA_DIR=/home/orangepi/data
#UPLOADER_STATE_DIR=/home/orangepi/data/uploader
